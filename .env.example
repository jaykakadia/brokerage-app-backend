# Database Configuration (Supabase PostgreSQL / Local PostgreSQL / SQLite)
DATABASE_URL=postgresql+psycopg://postgres:your-supabase-password@db.your-project.supabase.co:5432/postgres

# Security & Authentication
JWT_SECRET_KEY=generate_a_secure_random_32_byte_secret_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CSRF_SECRET_KEY=generate_a_secure_csrf_secret_for_production

# Cookies
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Storage
# local = this server's disk (VPS / dev), s3 = any S3-compatible bucket (Supabase Storage, R2, AWS S3, B2).
# The DB stores only keys like "listings/10/<uuid>.webp", so switching is: copy files with
# `python -m scripts.copy_media --from s3 --to local`, change these settings, redeploy.
STORAGE_BACKEND=local
# Public URL prefix for stored files: /uploads for local, the bucket's public URL for s3
MEDIA_BASE_URL=/uploads
UPLOAD_DIR=./uploads
# Supabase Storage example (only used when STORAGE_BACKEND=s3).
# Keys: Supabase dashboard -> Project Settings -> Storage -> S3 Access Keys.
#   MEDIA_BASE_URL=https://<ref>.supabase.co/storage/v1/object/public/listing-images
S3_ENDPOINT_URL=https://<ref>.supabase.co/storage/v1/s3
S3_BUCKET=listing-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1
# Cloudflare R2 instead: S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto,
#   MEDIA_BASE_URL=https://pub-xxxx.r2.dev
MAX_UPLOAD_SIZE_BYTES=5242880

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Application
ENVIRONMENT=development
APP_NAME="TradeCall API"

# Razorpay Payments (Test / Live Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_placeholder
RAZORPAY_MOCK=true

# SMTP Mail Service (Gmail / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@tradecall.in
SMTP_FROM_NAME="TradeCall India"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_MOCK=true

# Brevo email API (HTTPS). Set on hosts that block SMTP ports (Render free tier).
# BREVO_SENDER_EMAIL must be a verified sender in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
