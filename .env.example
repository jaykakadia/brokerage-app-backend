# Database Configuration (Supabase PostgreSQL / Local PostgreSQL / SQLite)
DATABASE_URL=postgresql+psycopg://postgres:your-supabase-password@db.your-project.supabase.co:5432/postgres

# Security & Authentication
JWT_SECRET_KEY=generate_a_secure_random_32_byte_secret_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CSRF_SECRET_KEY=generate_a_secure_csrf_secret_for_production

# Cookies
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Application
ENVIRONMENT=development
APP_NAME="TradeCall API"

# Razorpay Payments (Test / Live Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_placeholder
RAZORPAY_MOCK=true

# SMTP Mail Service (Gmail / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@tradecall.in
SMTP_FROM_NAME="TradeCall India"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_MOCK=true

# Brevo email API (HTTPS). Set on hosts that block SMTP ports (Render free tier).
# BREVO_SENDER_EMAIL must be a verified sender in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
